# ChromeGo proxy updater settings
#
# Copy to:
#   /home/sub2api/sub2api-deploy/chromego-proxy-update.env
# and adjust if your deployment paths or network names differ.

BASE_DIR=/home/sub2api/sub2api-deploy/chromego-proxy
DOCKER_NETWORK=sub2api-deploy_sub2api-network
SING_BOX_IMAGE=ghcr.io/sagernet/sing-box:latest
LIVE_CONTAINER_NAME=sub2api-chromego-proxy-live
LIVE_NETWORK_ALIAS=sub2api-chromego-proxy
APP_CONTAINER_NAME=sub2api
SOCKS_PORT=1082

PROBE_URL=https://api.ipify.org
PROBE_RETRIES=3
PROBE_INTERVAL_SECONDS=3
PROBE_STARTUP_SECONDS=5
PROBE_CONNECT_TIMEOUT_SECONDS=10
PROBE_MAX_TIME_SECONDS=30
PROBE_PORT_BASE=19080
